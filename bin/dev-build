#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

if ! git -C keeweb-source rev-parse --resolve-git-dir .git >/dev/null 2>&1; then
  if [[ -e keeweb-source || -L keeweb-source ]]; then
    backup="$(mktemp -d keeweb-source.backup.XXXXXX)"
    mv keeweb-source "$backup/keeweb-source"
    echo "keeweb-source is not a git repository; preserved it at $backup/keeweb-source" >&2
  fi
  git clone --branch "$(cat keeweb-version)" https://github.com/keeweb/keeweb.git keeweb-source
fi

bash bin/build
npm --prefix keeweb ci
npm --prefix keeweb run build
